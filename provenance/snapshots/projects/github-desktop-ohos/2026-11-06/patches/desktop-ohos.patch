diff --git a/app/src/lib/ohos/ohos-environment.ts b/app/src/lib/ohos/ohos-environment.ts
new file mode 100644
index 0000000..2984c2d
--- /dev/null
+++ b/app/src/lib/ohos/ohos-environment.ts
@@ -0,0 +1,180 @@
+import * as Fs from 'fs'
+import * as Os from 'os'
+import * as Path from 'path'
+
+/**
+ * HarmonyOS (Electron-on-OpenHarmony) runtime support.
+ *
+ * On HarmonyOS native executables can't live inside the app bundle, they are
+ * shipped as HNP (HarmonyOS Native Package) archives which the system extracts
+ * at install time. Private HNPs end up at
+ *
+ *   /data/app/<name>.org/<name>_<version>/
+ *
+ * The HAP ships three of them:
+ *
+ *  - git       Git 2.45.2 (with git-remote-https, git-lfs), from GitNext
+ *  - openssh   OpenSSH 9.8p1, from GitNext
+ *  - ghdtools  desktop-trampoline helpers + CA bundle, built by this port
+ *
+ * The version strings here must match the `version` in each HNP's hnp.json.
+ */
+const hnpRoot = (name: string, version: string) =>
+  `/data/app/${name}.org/${name}_${version}`
+
+export const OhosGitDir = hnpRoot('git', '2.45.2')
+export const OhosOpenSSHDir = hnpRoot('openssh', '9.8')
+export const OhosToolsDir = hnpRoot('ghdtools', '1.0')
+
+export const OhosAskpassTrampolinePath = Path.posix.join(
+  OhosToolsDir,
+  'bin',
+  'desktop-askpass-trampoline'
+)
+
+export const OhosSSHWrapperPath = Path.posix.join(
+  OhosToolsDir,
+  'bin',
+  'ssh-wrapper'
+)
+
+const OhosCABundlePath = Path.posix.join(OhosToolsDir, 'ssl', 'cacert.pem')
+
+/** App-private fallback for HOME when the inherited one isn't usable. */
+const OhosFallbackHome = '/data/storage/el2/base/files/home'
+
+function isWritableDirectory(path: string | undefined): path is string {
+  if (!path) {
+    return false
+  }
+
+  try {
+    Fs.accessSync(path, Fs.constants.W_OK)
+    return Fs.statSync(path).isDirectory()
+  } catch {
+    return false
+  }
+}
+
+function resolveHome(): string {
+  const candidates = [process.env.HOME, safeHomedir()]
+  const home = candidates.find(isWritableDirectory)
+
+  if (home !== undefined) {
+    return home
+  }
+
+  try {
+    Fs.mkdirSync(OhosFallbackHome, { recursive: true })
+  } catch {}
+
+  return OhosFallbackHome
+}
+
+function safeHomedir(): string | undefined {
+  try {
+    return Os.homedir()
+  } catch {
+    return undefined
+  }
+}
+
+/** ssh is invoked with `-F ~/.ssh/config` which fails if the file is missing */
+function ensureSSHConfig(home: string) {
+  try {
+    const sshDir = Path.posix.join(home, '.ssh')
+    Fs.mkdirSync(sshDir, { recursive: true, mode: 0o700 })
+    const config = Path.posix.join(sshDir, 'config')
+    if (!Fs.existsSync(config)) {
+      Fs.writeFileSync(config, '', { mode: 0o600 })
+    }
+  } catch {}
+}
+
+/**
+ * With GIT_CONFIG_GLOBAL set explicitly, `git config --global --list` fails
+ * if the file doesn't exist, unlike the default ~/.gitconfig lookup.
+ */
+function ensureFile(path: string) {
+  try {
+    if (!Fs.existsSync(path)) {
+      Fs.writeFileSync(path, '', { mode: 0o600 })
+    }
+  } catch {}
+  return path
+}
+
+/**
+ * Files under /storage/Users/currentUser are owned by a different uid than
+ * the app's sandbox user, so git's ownership check ("detected dubious
+ * ownership") rejects every repository there. The ownership check guards
+ * against other local users' repositories, which doesn't apply to the
+ * sandbox; this global config file is private to the app.
+ */
+function ensureSafeDirectoryWildcard(globalConfig: string) {
+  try {
+    const contents = Fs.readFileSync(globalConfig, 'utf8')
+    if (!/^\s*directory\s*=\s*\*\s*$/m.test(contents)) {
+      const separator = contents.length === 0 || contents.endsWith('\n') ? '' : '\n'
+      Fs.appendFileSync(globalConfig, `${separator}[safe]\n\tdirectory = *\n`)
+    }
+  } catch {}
+}
+
+let configured = false
+
+/**
+ * Point dugite, git and ssh at the HNP-installed binaries.
+ *
+ * Must run in every process that spawns git (both the main process and the
+ * renderer) before the first git invocation. The renderer can't rely on
+ * inheriting the main process environment on HarmonyOS since its processes
+ * are started by the ArkTS host rather than forked from the main process.
+ */
+export function configureOhosEnvironment() {
+  if (!__OHOS__ || configured) {
+    return
+  }
+
+  configured = true
+
+  const env = process.env
+
+  env.HOME = resolveHome()
+  ensureSSHConfig(env.HOME)
+
+  // The git.hnp build (GitNext) redirects the global config to
+  // /storage/Users/currentUser/.ohos_git/gitconfig, which this app can't
+  // read. GIT_CONFIG_GLOBAL takes precedence over that in git_global_config().
+  env.GIT_CONFIG_GLOBAL = ensureFile(Path.posix.join(env.HOME, '.gitconfig'))
+  ensureSafeDirectoryWildcard(env.GIT_CONFIG_GLOBAL)
+
+  // dugite resolves bin/git, libexec/git-core, share/git-core/templates and
+  // etc/gitconfig relative to LOCAL_GIT_DIRECTORY.
+  env.LOCAL_GIT_DIRECTORY = OhosGitDir
+  env.GIT_EXEC_PATH = Path.posix.join(OhosGitDir, 'libexec', 'git-core')
+
+  // The git HNP was compiled with a /data/service/hnp prefix so its built-in
+  // system config and template paths don't exist when installed as a private
+  // HNP. dugite sets GIT_TEMPLATE_DIR for us; the system config we skip.
+  env.GIT_CONFIG_NOSYSTEM = '1'
+
+  // libcurl inside git-remote-https looks for /etc/ssl/certs/cacert.pem which
+  // isn't guaranteed to exist on HarmonyOS. Use the bundled Mozilla bundle.
+  if (!env.GIT_SSL_CAINFO && Fs.existsSync(OhosCABundlePath)) {
+    env.GIT_SSL_CAINFO = OhosCABundlePath
+  }
+
+  // git-lfs and ssh are resolved through PATH by git and by ssh-wrapper.
+  const extraPath = [
+    Path.posix.join(OhosGitDir, 'bin'),
+    Path.posix.join(OhosOpenSSHDir, 'bin'),
+    Path.posix.join(OhosToolsDir, 'bin'),
+  ]
+  const currentPath = env.PATH ?? '/bin:/usr/bin'
+  env.PATH = [...extraPath, currentPath].join(':')
+
+  // No terminal to prompt on, and no pager/editor to launch.
+  env.GIT_TERMINAL_PROMPT = '0'
+  env.GIT_PAGER = 'cat'
+}
diff --git a/app/src/lib/ohos/remote-child-process.ts b/app/src/lib/ohos/remote-child-process.ts
new file mode 100644
index 0000000..7e9959c
--- /dev/null
+++ b/app/src/lib/ohos/remote-child-process.ts
@@ -0,0 +1,307 @@
+/**
+ * HarmonyOS: a `child_process` stand-in for the renderer that runs processes
+ * in the main process (see main-process/ohos-process-host.ts for why).
+ *
+ * The renderer webpack build substitutes this module for `child_process`
+ * inside dugite only. It implements the subset of the Node API dugite uses —
+ * `spawn(file, args, { cwd, env })` and `execFile(file, args, options, cb)` —
+ * with ChildProcess-like objects: stdout/stderr readable streams, a writable
+ * stdin, kill(), and 'spawn' / 'error' / 'exit' / 'close' events whose
+ * arguments match Node's.
+ */
+import { ipcRenderer } from 'electron'
+import { EventEmitter } from 'events'
+import * as Path from 'path'
+import { PassThrough, Writable } from 'stream'
+import {
+  OhosProcessEvent,
+  OhosProcessEventChannel,
+  OhosProcessKillChannel,
+  OhosProcessSpawnChannel,
+  OhosProcessStdinChannel,
+  IOhosSpawnRequest,
+} from './remote-process-protocol'
+
+const live = new Map<string, RemoteChildProcess>()
+let listening = false
+
+function listen() {
+  if (listening) {
+    return
+  }
+  listening = true
+  ipcRenderer.on(OhosProcessEventChannel, (_, event: OhosProcessEvent) =>
+    live.get(event.id)?.handle(event)
+  )
+}
+
+const toBuffer = (data: Uint8Array) =>
+  Buffer.from(data.buffer, data.byteOffset, data.byteLength)
+
+export class RemoteChildProcess extends EventEmitter {
+  public readonly stdout = new PassThrough()
+  public readonly stderr = new PassThrough()
+  public readonly stdin: Writable
+  public readonly spawnfile: string
+  public readonly spawnargs: ReadonlyArray<string>
+  public pid: number | undefined = undefined
+  public exitCode: number | null = null
+  public signalCode: NodeJS.Signals | null = null
+  public killed = false
+
+  private readonly id = crypto.randomUUID()
+
+  public constructor(
+    file: string,
+    args: ReadonlyArray<string>,
+    options: { cwd?: string; env?: Record<string, string | undefined> }
+  ) {
+    super()
+    this.spawnfile = file
+    this.spawnargs = [file, ...args]
+
+    const id = this.id
+    this.stdin = new Writable({
+      write(chunk: Buffer, _encoding, callback) {
+        ipcRenderer.send(OhosProcessStdinChannel, { id, data: chunk })
+        callback()
+      },
+      final(callback) {
+        ipcRenderer.send(OhosProcessStdinChannel, { id, end: true })
+        callback()
+      },
+    })
+
+    listen()
+    live.set(id, this)
+
+    const request: IOhosSpawnRequest = {
+      id,
+      file,
+      args: [...args],
+      cwd: options.cwd,
+      neutralCwd: isNeutralCwd(options.cwd),
+      env: options.env ? withoutUndefined(options.env) : undefined,
+    }
+    ipcRenderer.send(OhosProcessSpawnChannel, request)
+  }
+
+  public kill(signal: NodeJS.Signals | number = 'SIGTERM') {
+    if (this.exitCode !== null || this.signalCode !== null) {
+      return false
+    }
+    this.killed = true
+    ipcRenderer.send(OhosProcessKillChannel, { id: this.id, signal })
+    return true
+  }
+
+  /** @internal */
+  public handle(event: OhosProcessEvent) {
+    switch (event.type) {
+      case 'spawn':
+        this.pid = event.pid
+        this.emit('spawn')
+        break
+      case 'stdout':
+        this.stdout.write(toBuffer(event.data))
+        break
+      case 'stderr':
+        this.stderr.write(toBuffer(event.data))
+        break
+      case 'error': {
+        const err: NodeJS.ErrnoException = new Error(event.message)
+        err.code = event.code
+        err.errno = event.errno
+        err.syscall = event.syscall
+        err.path = this.spawnfile
+        Object.assign(err, { spawnargs: this.spawnargs.slice(1) })
+        this.emit('error', err)
+        break
+      }
+      case 'exit':
+        this.exitCode = event.code
+        this.signalCode = event.signal
+        this.emit('exit', event.code, event.signal)
+        break
+      case 'close':
+        live.delete(this.id)
+        this.stdout.end()
+        this.stderr.end()
+        // Let already-written output flush to 'data' listeners first
+        setImmediate(() => this.emit('close', event.code, event.signal))
+        break
+    }
+  }
+}
+
+/**
+ * Git commands that don't operate on a repository (global config, --version)
+ * run with the renderer bundle's __dirname or the renderer's cwd as working
+ * directory. Those are renderer-side paths which don't necessarily exist for
+ * the main process, where the command actually runs; flag them so the host
+ * may substitute a directory that does. Other paths (repositories) must be
+ * used as-is, a missing repository has to surface as ENOENT.
+ */
+function isNeutralCwd(cwd: string | undefined) {
+  if (cwd === undefined) {
+    return false
+  }
+  const neutral = [__dirname, safeCwd()].filter(
+    (dir): dir is string => dir !== undefined
+  )
+  return neutral.some(dir => Path.resolve(dir) === Path.resolve(cwd))
+}
+
+function safeCwd() {
+  try {
+    return process.cwd()
+  } catch {
+    return undefined
+  }
+}
+
+function withoutUndefined(env: Record<string, string | undefined>) {
+  const result: Record<string, string> = {}
+  for (const [key, value] of Object.entries(env)) {
+    if (value !== undefined) {
+      result[key] = value
+    }
+  }
+  return result
+}
+
+export function spawn(
+  file: string,
+  args: ReadonlyArray<string> = [],
+  options: { cwd?: string; env?: Record<string, string | undefined> } = {}
+) {
+  return new RemoteChildProcess(file, args, options)
+}
+
+interface IExecFileOptions {
+  readonly cwd?: string
+  readonly env?: Record<string, string | undefined>
+  readonly encoding?: BufferEncoding | 'buffer' | null
+  readonly maxBuffer?: number
+  readonly signal?: AbortSignal
+  readonly killSignal?: NodeJS.Signals | number
+}
+
+type ExecFileCallback = (
+  err: Error | null,
+  stdout: string | Buffer,
+  stderr: string | Buffer
+) => void
+
+export function execFile(
+  file: string,
+  args: ReadonlyArray<string>,
+  options: IExecFileOptions,
+  callback: ExecFileCallback
+) {
+  const child = spawn(file, args, options)
+  const encoding = options.encoding === null ? 'buffer' : options.encoding ?? 'utf8'
+  const maxBuffer = options.maxBuffer ?? 1024 * 1024
+  const killSignal = options.killSignal ?? 'SIGTERM'
+
+  // Like Node's execFile: with a text encoding the stdio streams themselves
+  // are decoded (setEncoding), so consumers that attach to them — e.g.
+  // Desktop's progress parser via processCallback + byline — get strings.
+  if (encoding !== 'buffer') {
+    child.stdout.setEncoding(encoding)
+    child.stderr.setEncoding(encoding)
+  }
+
+  const stdoutChunks = new Array<Buffer | string>()
+  const stderrChunks = new Array<Buffer | string>()
+  let stdoutLength = 0
+  let stderrLength = 0
+  let pendingError: Error | null = null
+  let done = false
+
+  const decode = (chunks: Array<Buffer | string>) =>
+    encoding === 'buffer'
+      ? Buffer.concat(chunks as Buffer[])
+      : (chunks as string[]).join('')
+
+  // maxBuffer is in bytes, as in Node
+  const byteLength = (chunk: Buffer | string) =>
+    typeof chunk === 'string'
+      ? Buffer.byteLength(chunk, encoding === 'buffer' ? 'utf8' : encoding)
+      : chunk.length
+
+  const finish = (err: Error | null) => {
+    if (done) {
+      return
+    }
+    done = true
+    options.signal?.removeEventListener('abort', onAbort)
+    callback(err, decode(stdoutChunks), decode(stderrChunks))
+  }
+
+  const fail = (err: Error) => {
+    if (pendingError === null) {
+      pendingError = err
+      child.kill(killSignal)
+    }
+  }
+
+  child.stdout.on('data', (chunk: Buffer | string) => {
+    stdoutLength += byteLength(chunk)
+    if (stdoutLength > maxBuffer) {
+      const err = new RangeError('stdout maxBuffer length exceeded')
+      fail(Object.assign(err, { code: 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER' }))
+    } else {
+      stdoutChunks.push(chunk)
+    }
+  })
+
+  child.stderr.on('data', (chunk: Buffer | string) => {
+    stderrLength += byteLength(chunk)
+    if (stderrLength > maxBuffer) {
+      const err = new RangeError('stderr maxBuffer length exceeded')
+      fail(Object.assign(err, { code: 'ERR_CHILD_PROCESS_STDIO_MAXBUFFER' }))
+    } else {
+      stderrChunks.push(chunk)
+    }
+  })
+
+  const onAbort = () => {
+    const err = new Error('The operation was aborted')
+    fail(Object.assign(err, { name: 'AbortError', code: 'ABORT_ERR' }))
+  }
+
+  if (options.signal?.aborted) {
+    onAbort()
+  } else {
+    options.signal?.addEventListener('abort', onAbort)
+  }
+
+  child.on('error', (err: Error) => finish(pendingError ?? err))
+
+  child.on('close', (code: number | null, signal: NodeJS.Signals | null) => {
+    if (pendingError !== null) {
+      return finish(pendingError)
+    }
+    if (code === 0 && signal === null) {
+      return finish(null)
+    }
+
+    // Same shape as Node's execFile error: numeric exit code (dugite relies
+    // on `typeof err.code === 'number'`), or code null + signal when killed.
+    const cmd = [file, ...args].join(' ')
+    const err = new Error(
+      `Command failed: ${cmd}\n${decode(stderrChunks).toString()}`
+    )
+    finish(
+      Object.assign(err, {
+        code,
+        killed: child.killed,
+        signal,
+        cmd,
+      })
+    )
+  })
+
+  return child
+}
