new file mode 100644
index 0000000..26577af
--- /dev/null
+++ b/app/src/lib/ohos/shims/keytar.ts
@@ -0,0 +1,83 @@
+/**
+ * keytar replacement for HarmonyOS.
+ *
+ * keytar is a native (NAN) addon backed by libsecret/Keychain/Credential
+ * Manager, none of which exist on HarmonyOS and the addon can't be loaded by
+ * the Electron fork. Credentials are instead kept in a JSON file inside the
+ * app sandbox:
+ *
+ *   /data/storage/el2/base/files/credentials.json   (mode 0600)
+ *
+ * el2 storage is only accessible to this app and is encrypted by the system
+ * with the user's lock screen credentials, which is the closest HarmonyOS
+ * equivalent of a per-user keychain available without a native module.
+ * A future version should move this to the HUKS/Asset Store kit via NAPI.
+ */
+import * as Fs from 'fs'
+import * as Path from 'path'
+
+const StorePath = '/data/storage/el2/base/files/credentials.json'
+
+type Store = Record<string, Record<string, string>>
+
+function read(): Store {
+  try {
+    const parsed = JSON.parse(Fs.readFileSync(StorePath, 'utf8'))
+    return typeof parsed === 'object' && parsed !== null ? parsed : {}
+  } catch {
+    return {}
+  }
+}
+
+function write(store: Store) {
+  Fs.mkdirSync(Path.dirname(StorePath), { recursive: true })
+  const tmp = `${StorePath}.${process.pid}.tmp`
+  Fs.writeFileSync(tmp, JSON.stringify(store), { mode: 0o600 })
+  Fs.renameSync(tmp, StorePath)
+}
+
+export async function getPassword(
+  service: string,
+  account: string
+): Promise<string | null> {
+  return read()[service]?.[account] ?? null
+}
+
+export async function setPassword(
+  service: string,
+  account: string,
+  password: string
+): Promise<void> {
+  const store = read()
+  store[service] = { ...store[service], [account]: password }
+  write(store)
+}
+
+export async function deletePassword(
+  service: string,
+  account: string
+): Promise<boolean> {
+  const store = read()
+  if (store[service]?.[account] === undefined) {
+    return false
+  }
+  delete store[service][account]
+  write(store)
+  return true
+}
+
+export async function findPassword(service: string): Promise<string | null> {
+  const accounts = read()[service] ?? {}
+  const first = Object.keys(accounts)[0]
+  return first === undefined ? null : accounts[first]
+}
+
+export async function findCredentials(
+  service: string
+): Promise<Array<{ account: string; password: string }>> {
+  const accounts = read()[service] ?? {}
+  return Object.entries(accounts).map(([account, password]) => ({
+    account,
+    password,
+  }))
+}
