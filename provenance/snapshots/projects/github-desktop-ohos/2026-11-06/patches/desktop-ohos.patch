+/**
+ * fs-admin replacement for HarmonyOS. The real module performs privileged
+ * file operations through an OS authorization prompt (used to install the
+ * `github` CLI into /usr/local/bin), which doesn't exist on HarmonyOS.
+ */
+type Callback = (error: Error | null) => void
+
+const unsupported = (callback: Callback) =>
+  setImmediate(() =>
+    callback(new Error('Privileged file operations are not supported on HarmonyOS'))
+  )
+
+export function clearAuthorizationCache(): void {}
+
+export function createWriteStream(_filePath: string): void {
+  throw new Error('Privileged file operations are not supported on HarmonyOS')
+}
+
+export function makeTree(_directoryPath: string, callback: Callback) {
+  unsupported(callback)
+}
+
+export function recursiveCopy(_source: string, _dest: string, callback: Callback) {
+  unsupported(callback)
+}
+
+export function symlink(_target: string, _filePath: string, callback: Callback) {
+  unsupported(callback)
+}
+
+export function unlink(_filePath: string, callback: Callback) {
+  unsupported(callback)
+}
