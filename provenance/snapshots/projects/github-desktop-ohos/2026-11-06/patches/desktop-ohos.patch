diff --git a/app/src/main-process/ohos-process-host.ts b/app/src/main-process/ohos-process-host.ts
new file mode 100644
index 0000000..bc69c94
--- /dev/null
+++ b/app/src/main-process/ohos-process-host.ts
@@ -0,0 +1,186 @@
+import { ipcMain, IpcMainEvent, WebContents } from 'electron'
+import { ChildProcess, spawn } from 'child_process'
+import * as Fs from 'fs'
+import { OhosToolsDir } from '../lib/ohos/ohos-environment'
+import {
+  OhosProcessEvent,
+  OhosProcessEventChannel,
+  OhosProcessKillChannel,
+  OhosProcessSpawnChannel,
+  OhosProcessStdinChannel,
+  IOhosSpawnRequest,
+  IOhosStdinRequest,
+  IOhosKillRequest,
+} from '../lib/ohos/remote-process-protocol'
+
+/**
+ * HarmonyOS: runs child processes on behalf of renderer processes.
+ *
+ * Electron-on-OpenHarmony renderers run in the Chromium render sandbox which
+ * can't see the HNP install locations (/data/app/<name>.org/...), so dugite's
+ * execFile/spawn in the renderer fail with ENOENT. The renderer bundle swaps
+ * dugite's child_process for a proxy (lib/ohos/remote-child-process) that
+ * forwards to this host, which spawns in the main process where HNP binaries
+ * are reachable, and streams stdio/exit back over IPC.
+ */
+export function installOhosProcessHost() {
+  const processes = new Map<string, ChildProcess>()
+  const tracked = new WeakSet<WebContents>()
+
+  const send = (sender: WebContents, event: OhosProcessEvent) => {
+    if (!sender.isDestroyed()) {
+      sender.send(OhosProcessEventChannel, event)
+    }
+  }
+
+  const track = (sender: WebContents) => {
+    if (tracked.has(sender)) {
+      return
+    }
+    tracked.add(sender)
+    // Don't leave git processes behind when a window goes away
+    sender.once('destroyed', () => {
+      for (const [key, cp] of processes) {
+        if (key.startsWith(`${sender.id}:`)) {
+          cp.kill()
+          processes.delete(key)
+        }
+      }
+    })
+  }
+
+  ipcMain.on(
+    OhosProcessSpawnChannel,
+    (event: IpcMainEvent, request: IOhosSpawnRequest) => {
+      const { sender } = event
+      const { id, file, args } = request
+      const cwd =
+        request.cwd === undefined ||
+        (request.neutralCwd && !Fs.existsSync(request.cwd))
+          ? existingDir(process.env.HOME)
+          : request.cwd
+      const env = withMainOhosEnv(request.env)
+      const key = `${sender.id}:${id}`
+      track(sender)
+
+      let cp: ChildProcess
+      try {
+        cp = spawn(file, args, { cwd, env })
+      } catch (e) {
+        const err = e as NodeJS.ErrnoException
+        send(sender, {
+          id,
+          type: 'error',
+          code: err.code,
+          message: err.message,
+        })
+        return
+      }
+
+      processes.set(key, cp)
+
+      cp.on('spawn', () => send(sender, { id, type: 'spawn', pid: cp.pid }))
+      cp.stdout?.on('data', (data: Buffer) =>
+        send(sender, { id, type: 'stdout', data })
+      )
+      cp.stderr?.on('data', (data: Buffer) =>
+        send(sender, { id, type: 'stderr', data })
+      )
+      // stdin errors (EPIPE when git exits early) surface via the exit code
+      cp.stdin?.on('error', () => {})
+
+      cp.on('error', (err: NodeJS.ErrnoException) => {
+        if (err.code === 'ENOENT') {
+          const detail = !Fs.existsSync(file)
+            ? `executable not found: ${file}`
+            : cwd !== undefined && !Fs.existsSync(cwd)
+            ? `working directory not found: ${cwd}`
+            : 'executable or its interpreter could not be loaded'
+          log.warn(`[ohos] spawn ${file} ${args.join(' ')} failed: ${detail}`)
+        }
+        send(sender, {
+          id,
+          type: 'error',
+          code: err.code,
+          errno: err.errno,
+          syscall: err.syscall,
+          message: err.message,
+        })
+        processes.delete(key)
+      })
+
+      cp.on('exit', (code, signal) =>
+        send(sender, { id, type: 'exit', code, signal })
+      )
+      cp.on('close', (code, signal) => {
+        send(sender, { id, type: 'close', code, signal })
+        processes.delete(key)
+      })
+    }
+  )
+
+  ipcMain.on(
+    OhosProcessStdinChannel,
+    (event: IpcMainEvent, { id, data, end }: IOhosStdinRequest) => {
+      const stdin = processes.get(`${event.sender.id}:${id}`)?.stdin
+      if (!stdin || stdin.destroyed) {
+        return
+      }
+      if (data !== undefined) {
+        stdin.write(Buffer.from(data))
+      }
+      if (end) {
+        stdin.end()
+      }
+    }
+  )
+
+  ipcMain.on(
+    OhosProcessKillChannel,
+    (event: IpcMainEvent, { id, signal }: IOhosKillRequest) => {
+      processes.get(`${event.sender.id}:${id}`)?.kill(signal)
+    }
+  )
+}
+
+const existingDir = (dir: string | undefined) =>
+  dir !== undefined && Fs.existsSync(dir) ? dir : undefined
+
+/**
+ * The git/ssh environment is configured in each process at startup
+ * (lib/ohos/ohos-environment.ts). Fill in anything the renderer's copy is
+ * missing or got wrong from the main process' own, known-good environment.
+ */
+function withMainOhosEnv(env: Record<string, string | undefined> | undefined) {
+  if (env === undefined) {
+    return undefined
+  }
+
+  const result = { ...env }
+  const main = process.env
+
+  for (const key of [
+    'HOME',
+    'GIT_CONFIG_GLOBAL',
+    'GIT_CONFIG_NOSYSTEM',
+    'GIT_TERMINAL_PROMPT',
+  ]) {
+    if (result[key] === undefined && main[key] !== undefined) {
+      result[key] = main[key]
+    }
+  }
+
+  if (result.HOME !== undefined && !Fs.existsSync(result.HOME)) {
+    result.HOME = main.HOME
+  }
+
+  if (!result.GIT_SSL_CAINFO || !Fs.existsSync(result.GIT_SSL_CAINFO)) {
+    result.GIT_SSL_CAINFO = main.GIT_SSL_CAINFO
+  }
+
+  if (!(result.PATH ?? '').includes(OhosToolsDir) && main.PATH !== undefined) {
+    result.PATH = main.PATH
+  }
+
+  return result
+}
diff --git a/app/src/main-process/ohos-uncaught-exception.ts b/app/src/main-process/ohos-uncaught-exception.ts
new file mode 100644
index 0000000..2848e53
--- /dev/null
+++ b/app/src/main-process/ohos-uncaught-exception.ts
@@ -0,0 +1,66 @@
+import { app, dialog } from 'electron'
+import { AppWindow } from './app-window'
+
+let dialogOpen = false
+
+/**
+ * Renderer errors arrive over IPC and may be ErrorEvents or other non-Error
+ * objects whose properties don't survive serialization (they showed up as
+ * "[Unknown]: [Unknown]"), so describe whatever we got.
+ */
+export function describeError(error: unknown): string {
+  if (error instanceof Error) {
+    return error.stack ?? `${error.name}: ${error.message}`
+  }
+  if (error && typeof error === 'object') {
+    const e = error as Record<string, unknown>
+    const parts = ['name', 'message', 'filename', 'lineno', 'colno', 'stack']
+      .filter(key => e[key] !== undefined && e[key] !== '')
+      .map(key => `${key}: ${String(e[key])}`)
+    if (parts.length > 0) {
+      return parts.join('\n')
+    }
+    try {
+      return JSON.stringify(error)
+    } catch {}
+  }
+  return String(error)
+}
+
+/**
+ * HarmonyOS replacement for Desktop's crash flow (destroy the main window and
+ * show the crash window), whose crash window the Electron fork never shows.
+ */
+export async function handleOhosUncaughtException(
+  error: unknown,
+  window: AppWindow
+) {
+  const details = describeError(error)
+  log.error(`[ohos] uncaught exception\n${details}`)
+
+  if (dialogOpen) {
+    return
+  }
+  dialogOpen = true
+  try {
+    // Unparented on purpose: window-modal boxes aren't drawn on the fork
+    const { response } = await dialog.showMessageBox({
+      type: 'error',
+      title: 'Unexpected error',
+      message: 'GitHub Desktop encountered an unexpected error.',
+      detail: `${details}\n\nThe app may be in an inconsistent state. Reloading the window is the safest option.`,
+      buttons: ['Reload window', 'Continue', 'Quit'],
+      defaultId: 0,
+      cancelId: 1,
+    })
+    if (response === 0) {
+      window.reload()
+    } else if (response === 2) {
+      app.quit()
+    }
+  } catch (e) {
+    log.error('[ohos] could not show uncaught exception dialog', e)
+  } finally {
+    dialogOpen = false
+  }
+}
