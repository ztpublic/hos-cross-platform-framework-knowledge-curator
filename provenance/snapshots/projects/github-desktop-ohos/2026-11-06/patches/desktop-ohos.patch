+/** IPC protocol between lib/ohos/remote-child-process (renderer) and
+ * main-process/ohos-process-host (main). HarmonyOS only. */
+
+export const OhosProcessSpawnChannel = 'ohos-process:spawn'
+export const OhosProcessStdinChannel = 'ohos-process:stdin'
+export const OhosProcessKillChannel = 'ohos-process:kill'
+export const OhosProcessEventChannel = 'ohos-process:event'
+
+export interface IOhosSpawnRequest {
+  readonly id: string
+  readonly file: string
+  readonly args: ReadonlyArray<string>
+  readonly cwd?: string
+
+  /**
+   * The cwd is a renderer-side default (bundle dir / renderer cwd) rather
+   * than a repository; the host may replace it if it doesn't exist there.
+   */
+  readonly neutralCwd?: boolean
+  readonly env?: Record<string, string | undefined>
+}
+
+export interface IOhosStdinRequest {
+  readonly id: string
+  readonly data?: Uint8Array
+  readonly end?: boolean
+}
+
+export interface IOhosKillRequest {
+  readonly id: string
+  readonly signal?: NodeJS.Signals | number
+}
+
+export type OhosProcessEvent =
+  | { readonly id: string; readonly type: 'spawn'; readonly pid?: number }
+  | {
+      readonly id: string
+      readonly type: 'stdout' | 'stderr'
+      readonly data: Uint8Array
+    }
+  | {
+      readonly id: string
+      readonly type: 'error'
+      readonly code?: string
+      readonly errno?: number
+      readonly syscall?: string
+      readonly message: string
+    }
+  | {
+      readonly id: string
+      readonly type: 'exit' | 'close'
+      readonly code: number | null
+      readonly signal: NodeJS.Signals | null
+    }
