diff --git a/app/src/ui/lib/token-sign-in.tsx b/app/src/ui/lib/token-sign-in.tsx
new file mode 100644
index 0000000..02243e2
--- /dev/null
+++ b/app/src/ui/lib/token-sign-in.tsx
@@ -0,0 +1,102 @@
+import * as React from 'react'
+import { Row } from './row'
+import { TextBox } from './text-box'
+import { Button } from './button'
+import { LinkButton } from './link-button'
+import { Loading } from './loading'
+import { getHTMLURL } from '../../lib/api'
+
+/** Scopes GitHub Desktop needs for everything it does with the API and git */
+const TokenScopes = ['repo', 'read:org', 'user', 'workflow']
+
+/** URL of the "new classic personal access token" page, prefilled */
+export function getNewTokenURL(endpoint: string) {
+  const description = encodeURIComponent('GitHub Desktop (HarmonyOS)')
+  const scopes = TokenScopes.join(',')
+  return `${getHTMLURL(endpoint)}/settings/tokens/new?scopes=${scopes}&description=${description}`
+}
+
+interface ITokenSignInProps {
+  readonly endpoint: string
+  readonly loading: boolean
+
+  /**
+   * Called with the entered token. When omitted no submit button is rendered
+   * and the owner (e.g. a dialog) is expected to submit via onTokenChanged.
+   */
+  readonly onSubmit?: (token: string) => void
+  readonly onTokenChanged?: (token: string) => void
+}
+
+interface ITokenSignInState {
+  readonly token: string
+}
+
+/**
+ * Personal access token sign-in, used on HarmonyOS where the browser OAuth
+ * redirect back into the app isn't available.
+ */
+export class TokenSignIn extends React.Component<
+  ITokenSignInProps,
+  ITokenSignInState
+> {
+  public constructor(props: ITokenSignInProps) {
+    super(props)
+    this.state = { token: '' }
+  }
+
+  private onTokenChanged = (token: string) => {
+    this.setState({ token })
+    this.props.onTokenChanged?.(token)
+  }
+
+  private onSubmit = () => {
+    const token = this.state.token.trim()
+    if (token.length > 0 && !this.props.loading) {
+      this.props.onSubmit?.(token)
+    }
+  }
+
+  public render() {
+    const { endpoint, loading, onSubmit } = this.props
+    const host = new URL(getHTMLURL(endpoint)).host
+
+    return (
+      <div className="token-sign-in">
+        <p>
+          Sign in to {host} with a personal access token.{' '}
+          <LinkButton uri={getNewTokenURL(endpoint)}>
+            Create a token in your browser
+          </LinkButton>{' '}
+          (classic token with the <code>{TokenScopes.join(', ')}</code>{' '}
+          scopes), then paste it below.
+        </p>
+        <Row>
+          <TextBox
+            label="Personal access token"
+            type="password"
+            value={this.state.token}
+            onValueChanged={this.onTokenChanged}
+            onEnterPressed={onSubmit ? this.onSubmit : undefined}
+            placeholder="ghp_…"
+            disabled={loading}
+            autoFocus={true}
+            spellcheck={false}
+          />
+        </Row>
+        {onSubmit && (
+          <Row>
+            <Button
+              type="button"
+              onClick={this.onSubmit}
+              disabled={loading || this.state.token.trim().length === 0}
+            >
+              {loading && <Loading />}
+              Sign in
+            </Button>
+          </Row>
+        )}
+      </div>
+    )
+  }
+}
