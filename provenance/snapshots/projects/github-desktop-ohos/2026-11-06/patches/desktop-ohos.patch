diff --git a/app/ohos-dugite-loader.js b/app/ohos-dugite-loader.js
new file mode 100644
index 0000000..f80d9f7
--- /dev/null
+++ b/app/ohos-dugite-loader.js
@@ -0,0 +1,41 @@
+// HarmonyOS build only (renderer bundle), applied to dugite's build/lib files:
+//
+//  - exec.js / spawn.js: `require("child_process")` -> the renderer IPC proxy
+//    (src/lib/ohos/remote-child-process.ts) so git runs in the main process.
+//    NormalModuleReplacementPlugin can't do this: `child_process` is a Node
+//    builtin and webpack's externals check the dependency's original request.
+//
+//  - git-environment.js: the "embedded" git directory is the git.hnp install
+//    location, fixed at build time rather than relying on LOCAL_GIT_DIRECTORY
+//    surviving in the renderer's process.env.
+const path = require('path')
+
+const ohosLib = path.resolve(__dirname, 'src', 'lib', 'ohos')
+const proxy = path.join(ohosLib, 'remote-child-process.ts')
+const environment = path.join(ohosLib, 'ohos-environment.ts')
+
+module.exports = function ohosDugiteLoader(source) {
+  const file = path.basename(this.resourcePath)
+
+  if (file === 'git-environment.js') {
+    const patched = source.replace(
+      'function resolveEmbeddedGitDir() {',
+      `function resolveEmbeddedGitDir() {\n    return require(${JSON.stringify(
+        environment
+      )}).OhosGitDir;`
+    )
+    if (patched === source) {
+      throw new Error('ohos-dugite-loader: resolveEmbeddedGitDir not found')
+    }
+    return patched
+  }
+
+  const patched = source.replace(
+    /require\((["'])child_process\1\)/g,
+    `require(${JSON.stringify(proxy)})`
+  )
+  if (patched === source) {
+    throw new Error(`ohos-dugite-loader: no child_process require in ${file}`)
+  }
+  return patched
+}
