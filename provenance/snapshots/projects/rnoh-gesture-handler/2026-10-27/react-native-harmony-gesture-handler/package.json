{
  "name": "@react-native-ohos/react-native-gesture-handler",
  "harmony": {
    "alias": "react-native-gesture-handler",
    "redirectInternalImports": true,
    "autolinking": {
      "etsPackageClassName": "RnohReactNativeHarmonyGestureHandlerPackage",
      "cppPackageClassName": "RnohReactNativeHarmonyGestureHandlerPackage",
      "cmakeLibraryTargetName": "rnoh_gesture_handler",
      "ohPackageName": "@react-native-ohos/react-native-gesture-handler"
 	  }
  },
  "repository": {
    "type": "git",
    "url": "https://gitcode.com/CPF-RN/rntpc_react-native-gesture-handler.git"
  },
  "version": "2.31.0-beta.2",
  "description": "Declarative API exposing platform native touch and gesture system to React Native.",
  "react-native": "src/index.ts",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "scripts": {
    "prepack": "bob build && node ./scripts/copy-docs.js",
    "test": "jest",
    "pack:prod": "npm pack",
    "prepublishOnly": "npm run prepack && react-native verify-package-harmony --package-path . --skip-checks oh_package_name_is_derived_from_npm_package_name",
    "update_version": "node ./scripts/update-version.js",
    "deploy": "node ./scripts/deploy.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "2.33.0"
  },
  "keywords": [
    "react-native",
    "harmony",
    "harmonyos",
    "gesture-handler",
    "ohos",
    "openharmony",
    "rnoh"
  ],
  "author": "",
  "homepage": "https://gitcode.com/CPF-RN/rntpc_react-native-gesture-handler",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.12.7",
    "@react-native-community/cli": "20.0.0",
    "@react-native-oh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@0.82.30",
    "@react-native/babel-preset": "0.83.0",
    "@testing-library/react-native": "^12.5.1",
    "@types/hoist-non-react-statics": "^3.3.1",
    "@types/invariant": "^2.2.37",
    "@types/jest": "^27.0.3",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "clang-format": "^1.8.0",
    "eslint": "^8.57.0",
    "eslint-config-satya164": "3.3.0",
    "eslint-import-resolver-babel-module": "^5.2.0",
    "eslint-plugin-jest": "27.4.3",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^8.0.1",
    "jest": "^28.1.0",
    "lint-staged": "^12.3.2",
    "madge": "^6.1.0",
    "prettier": "3.3.3",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-builder-bob": "^0.40.13",
    "react-native-gesture-handler": "2.33.0",
    "react-native-reanimated": "^3.18.0",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.8.3"
  },
  "files": [
    "./harmony/*",
    "src",
    "lib",
    "DrawerLayout/",
    "Swipeable/",
    "ReanimatedSwipeable/",
    "ReanimatedDrawerLayout/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
