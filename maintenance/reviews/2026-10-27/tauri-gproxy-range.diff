+            .secret
+            .pointer(&format!("/provider_secrets/{LAST_REFRESH_MS}"))
+            .and_then(Value::as_i64)
+            .unwrap_or(0);
+        (last_refresh.saturating_add(interval) < now_ms).then_some(RefreshReason::Scheduled)
+    }
