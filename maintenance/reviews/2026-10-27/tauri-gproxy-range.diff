+pub fn sticky_slot(affinity_key: &str, provider_id: &str) -> u64 {
+    let mut value = fnv1a(affinity_key) ^ fnv1a(provider_id).rotate_left(32);
+    value ^= value >> 30;
+    value = value.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    value ^= value >> 27;
