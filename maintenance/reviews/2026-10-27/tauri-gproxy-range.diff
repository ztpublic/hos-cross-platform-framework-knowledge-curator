+            Ok(path.to_owned())
+        } else {
+            Ok(self.cwd.as_ref().map_or_else(
+                || path.to_owned(),
+                |cwd| format!("{}/{path}", cwd.trim_end_matches('/')),
+            ))
+        }
+    }
+}
