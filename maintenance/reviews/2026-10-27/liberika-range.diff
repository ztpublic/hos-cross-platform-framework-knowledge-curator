diff --git a/packages/erika_flutter/test/apple_export_symbols_contract_test.dart b/packages/erika_flutter/test/apple_export_symbols_contract_test.dart
new file mode 100644
index 0000000..8e7e564
--- /dev/null
+++ b/packages/erika_flutter/test/apple_export_symbols_contract_test.dart
@@ -0,0 +1,70 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+/// iOS and tvOS link liberika statically and look its functions up in the
+/// running executable (`dlsym` from the Swift plugin, `DynamicLibrary.process()`
+/// from the Dart exports). The linker drops what nothing references, so every
+/// function those lookups need is named in the podspec's `-u` list, except
+/// the ones newer than the pinned native artifacts: forcing a symbol the
+/// static library lacks fails the link, so those are listed as optional and
+/// force-linked only when the library the build produced defines them (a
+/// source build or a newer library does), until the release whose artifacts
+/// ship them moves them into the forced list.
+void main() {
+  final header = File('native/include/erika.h').readAsStringSync();
+  final declared = RegExp(r'\b(erika_\w+)\s*\(')
+      .allMatches(header.replaceAll(RegExp(r'/\*.*?\*/', dotAll: true), ''))
+      .map((match) => match.group(1)!)
+      .toSet();
+
+  Set<String> listed(String podspec, String name) {
+    final match = RegExp('$name = %w\\[(.*?)\\]', dotAll: true)
+        .firstMatch(podspec);
+    if (match == null) return {};
+    return match
+        .group(1)!
+        .split(RegExp(r'\s+'))
+        .where((name) => name.isNotEmpty)
+        .toSet();
+  }
+
+  for (final platform in <String>['ios', 'tvos']) {
+    test('$platform names every export and diagnostics function', () {
+      final podspec = File('$platform/erika_flutter.podspec').readAsStringSync();
+      final forced = listed(podspec, 'erika_cabi_symbols');
+      final optional = listed(podspec, 'erika_cabi_optional_symbols');
+      // In the pinned 0.2.1 artifacts: forced.
+      for (final symbol in <String>[
+        'erika_export_gif',
+        'erika_last_error_message',
+        'erika_string_free',
+        'erika_presenter_invoke_json',
+      ]) {
+        expect(forced, contains(symbol));
+      }
+      // Newer than the pinned artifacts: named, forced or optional.
+      for (final symbol in <String>[
+        'erika_export_frame',
+        'erika_frame_export_result_free',
+        'erika_frame_export_session_open',
+        'erika_frame_export_session_frame',
+        'erika_frame_export_session_close',
+        'erika_presenter_get_diagnostics_json',
+        'erika_log_read_json',
+      ]) {
+        expect(forced.union(optional), contains(symbol));
+      }
+      expect(forced.intersection(optional), isEmpty);
+      // The optional ones are force-linked when the produced library defines
+      // them: the build phase writes the flags, the link reads them.
+      expect(podspec, contains("for symbol in #{erika_cabi_optional_symbols.join(' ')}"));
+      expect(podspec, contains('nm -gU "\$OUTPUT_LIB"'));
+      expect(podspec,
+          contains('\\"@\$(PODS_TARGET_SRCROOT)/native/erika_optional_ldflags.rsp\\"'));
+      // A name that liberika does not define would fail the final link.
+      expect(declared.containsAll(forced), isTrue,
+          reason: 'not in erika.h: ${forced.difference(declared)}');
+    });
+  }
+}
diff --git a/packages/erika_flutter/test/apple_json_bridge_contract_test.dart b/packages/erika_flutter/test/apple_json_bridge_contract_test.dart
new file mode 100644
index 0000000..bf72294
--- /dev/null
+++ b/packages/erika_flutter/test/apple_json_bridge_contract_test.dart
@@ -0,0 +1,71 @@
+import 'dart:io';
+
+import 'package:flutter_test/flutter_test.dart';
+
+/// The macOS and iOS plugins run the JSON pass-through, the diagnostics
+/// snapshot and the logs off the main thread: they take as long as the work
+/// they ask for (a subtitle file parsed, a picture decoded), and on the
+/// platform thread that is the app's interface.
+void main() {
+  for (final platform in <String>['macos', 'ios']) {
+    group(platform, () {
+      late String plugin;
+      setUpAll(() {
+        plugin = File('$platform/Classes/ErikaFlutterPlugin.swift')
+            .readAsStringSync();
+      });
+
+      String handler(String method) {
+        final start = plugin.indexOf('      case "$method":');
+        expect(start, isNonNegative, reason: 'no handler for $method');
+        final next = plugin.indexOf('\n      case "', start + 1);
+        return plugin.substring(start, next);
+      }
+
+      test('answers invokeJson, getDiagnosticsSnapshot and getLogs after a '
+          'background queue did the work', () {
+        for (final method in <String>[
+          'invokeJson',
+          'getDiagnosticsSnapshot',
+          'getLogs',
+        ]) {
+          final body = handler(method);
+          expect(body, contains('respondOffMain('), reason: method);
+          expect(body, isNot(contains('result(try')), reason: method);
+        }
+        expect(plugin, contains('DispatchQueue.main.async {'));
+        expect(plugin, contains('let jsonQueue: DispatchQueue'));
+      });
+
+      test('methods without a presenter run without the native call lock', () {
+        expect(plugin, contains('library.isGlobalJsonMethod(method)'));
+        expect(plugin, contains('? call(nil)'));
+      });
+
+      test('main-thread timers skip a tick instead of waiting for the lock',
+          () {
+        expect(plugin, contains('_ = tryWithNativeCall {'));
+        expect(plugin, contains('guard nativeCallLock.try() else { return nil }'));
+      });
+    });
+  }
+
+  test('macOS exposes the frame export session to Dart', () {
+    final plugin = File('macos/Classes/ErikaFlutterPlugin.swift')
+        .readAsStringSync();
+    for (final method in <String>[
+      'openFrameExportSession',
+      'exportSessionFrame',
+      'closeFrameExportSession',
+    ]) {
+      expect(plugin, contains('case "$method"'));
+    }
+    for (final symbol in <String>[
+      'erika_frame_export_session_open',
+      'erika_frame_export_session_frame',
+      'erika_frame_export_session_close',
+    ]) {
+      expect(plugin, contains('"$symbol"'));
+    }
+  });
+}
