+/// Rust links the MSVC C runtime statically (`-C target-feature=+crt-static`),
+/// so the native libraries must too: `xtask deps build --crt static`.
+fn static_crt() -> bool {
+    env::var("CARGO_CFG_TARGET_ENV").as_deref() == Ok("msvc")
