+    }
+    input[type="file"] {
+      display: none;
+    }
+    input[type="range"] {
+      accent-color: #9caaff;
+    }
+    #seek {
+      flex: 1;
+      min-width: 200px;
+    }
+    #status {
+      white-space: pre-wrap;
+      overflow-wrap: anywhere;
+      color: #adb9ce;
+      font: 13px ui-monospace;
