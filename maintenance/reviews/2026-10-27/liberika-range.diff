+pub(crate) fn output_mode_label(mode: OutputMode) -> &'static str {
+    match mode {
+        OutputMode::Sdr => "sdr",
+        OutputMode::AppleEdr { .. } => "apple_edr",
+        OutputMode::ExtendedLinear { .. } => "extended_linear",
+        OutputMode::Auto { .. } => "auto",
+    }
+}
