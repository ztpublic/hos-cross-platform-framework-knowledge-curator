+
+/// Share the font already embedded for danmaku with the libass WASM module.
+/// Return an owned JS array so later Rust memory growth cannot invalidate it.
+#[wasm_bindgen(js_name = fallbackFont)]
+pub fn fallback_font() -> Uint8Array {
+    Uint8Array::from(crate::NIPAPLAY_FALLBACK_FONT)
+}
+
+#[wasm_bindgen]
+pub struct WebDanmaku {
+    timeline: DanmakuTimeline,
+    engine: DfmLayoutEngine,
+    prepared: Option<DfmPreparedLayout>,
+    config: DanmakuLayoutConfig,
+    window: f64,
+    viewport: Option<DanmakuViewport>,
+    pending_size_at: Option<f64>,
+    atlas_version: u64,
+    atlas_size: (u32, u32, usize),
+    size_deadline: Option<f64>,
+    fonts: Vec<SubtitleFontAttachment>,
+    font_generation: u64,
+}
+
+fn set(object: &Object, key: &str, value: JsValue) -> Result<(), JsValue> {
+    Reflect::set(object, &key.into(), &value).map(|_| ())
+}
+
+#[wasm_bindgen]
+impl WebDanmaku {
+    #[wasm_bindgen(constructor)]
+    pub fn new() -> Self {
+        let config = DanmakuLayoutConfig::default();
+        Self {
+            timeline: DanmakuTimeline::default(),
+            engine: DfmLayoutEngine::new(DanmakuTimeline::default(), config.clone()),
+            config,
+            prepared: None,
+            window: -100.0,
+            viewport: None,
+            pending_size_at: None,
+            atlas_version: 0,
+            atlas_size: (0, 0, 0),
+            size_deadline: None,
+            fonts: Vec::new(),
+            font_generation: 0,
+        }
+    }
+    pub fn load(&mut self, text: &str) -> Result<usize, JsValue> {
+        self.timeline =
+            DanmakuTimeline::parse_auto(text).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        self.prepared = None;
+        self.engine.invalidate_placement_history();
+        Ok(self.timeline.len())
+    }
+    /// Append a track without dropping the already mounted comments.
+    pub fn append(&mut self, text: &str) -> Result<usize, JsValue> {
+        let track =
+            DanmakuTimeline::parse_auto(text).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        let count = track.len();
+        let mut items = self.timeline.items().to_vec();
+        let base = items.iter().map(|i| i.id).max().unwrap_or(0);
+        items.extend(
+            track
+                .items()
+                .iter()
+                .cloned()
+                .enumerate()
+                .map(|(n, mut item)| {
+                    item.id = base + n as u64 + 1;
+                    item
+                }),
+        );
+        self.timeline =
+            DanmakuTimeline::new(items).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        self.prepared = None;
+        Ok(count)
+    }
+    /// Show the viewer's own comment, bordered, in `color` (`0xRRGGBB`;
+    /// white when omitted).
+    pub fn send(&mut self, text: &str, seconds: f64, color: Option<u32>) -> Result<(), JsValue> {
+        if !seconds.is_finite() || text.trim().is_empty() {
+            return Ok(());
+        }
+        let color = color.map_or(DanmakuColor::WHITE, |rgb| {
+            DanmakuColor::rgb_u8((rgb >> 16) as u8, (rgb >> 8) as u8, rgb as u8)
+        });
+        let mut items = self.timeline.items().to_vec();
+        items.push(DanmakuItem {
+            id: items.iter().map(|i| i.id).max().unwrap_or(0) + 1,
+            pts: Duration::from_secs_f64(seconds.max(0.0)),
+            text: text.into(),
+            mode: DanmakuMode::Scroll,
+            font_size: 25.0,
+            color,
+            opacity: 1.0,
+            is_self: true,
+        });
+        self.timeline =
+            DanmakuTimeline::new(items).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        self.prepared = None;
+        Ok(())
+    }
+    pub fn add_font(&mut self, name: &str, data: &[u8]) -> Result<(), JsValue> {
+        if data.len() > crate::font::MAX_MEMORY_SUBTITLE_FONT_BYTES {
+            return Err("Font exceeds 32 MiB".into());
+        }
+        if self.fonts.iter().map(|f| f.data.len()).sum::<usize>() + data.len()
+            > crate::font::MAX_MEMORY_SUBTITLE_FONT_TOTAL_BYTES
+        {
+            return Err("Fonts exceed 128 MiB".into());
+        }
+        self.fonts.push(SubtitleFontAttachment::new(
+            name,
+            None,
+            Vec::new(),
+            Arc::<[u8]>::from(data),
+        ));
+        self.font_generation += 1;
+        self.engine.set_font_selection(DanmakuFontSelection::new(
+            self.font_generation,
+            self.fonts.clone(),
+        ));
+        self.prepared = None;
+        Ok(())
+    }
+    pub fn configure(&mut self, json: &str, now_ms: f64) -> Result<(), JsValue> {
+        let v: serde_json::Value =
+            serde_json::from_str(json).map_err(|e| JsValue::from_str(&e.to_string()))?;
+        let old = self.config.clone();
+        for (key, slot) in [
+            ("fontSize", &mut self.config.font_size),
+            ("opacity", &mut self.config.opacity),
+            ("area", &mut self.config.display_area),
+            ("duration", &mut self.config.scroll_duration_seconds),
+            ("speed", &mut self.config.scroll_speed_factor),
+        ] {
+            if let Some(n) = v.get(key).and_then(|n| n.as_f64()) {
+                if n.is_finite() {
+                    *slot = n as f32;
+                }
+            }
+        }
+        for (key, slot) in [
+            ("enabled", &mut self.config.enabled),
+            ("supersampling", &mut self.config.supersampling),
+            ("blockTop", &mut self.config.block_top),
+            ("blockBottom", &mut self.config.block_bottom),
+            ("blockScroll", &mut self.config.block_scroll),
+            ("mergeDuplicates", &mut self.config.merge_duplicates),
+            ("randomColors", &mut self.config.random_colors),
+        ] {
+            if let Some(b) = v.get(key).and_then(|b| b.as_bool()) {
+                *slot = b;
+            }
+        }
+        self.config.font_size = self.config.font_size.clamp(1.0, 256.0);
+        self.config.opacity = self.config.opacity.clamp(0.0, 1.0);
+        self.config.scroll_duration_seconds = self.config.scroll_duration_seconds.clamp(1.0, 120.0);
+        self.config.scroll_speed_factor = self.config.scroll_speed_factor.clamp(0.1, 10.0);
+        if old.font_size != self.config.font_size {
+            let deadline = *self.size_deadline.get_or_insert(now_ms + 500.0);
+            self.pending_size_at = Some((now_ms + 120.0).min(deadline));
+        }
+        let mut paint = old.clone();
+        paint.font_size = self.config.font_size;
+        paint.opacity = self.config.opacity;
+        paint.enabled = self.config.enabled;
+        paint.random_colors = self.config.random_colors;
+        if paint != self.config {
+            self.prepared = None;
+            self.pending_size_at = None;
+        }
+        if let Some(p) = &mut self.prepared {
+            p.apply_paint_config(&self.config);
+        }
+        Ok(())
+    }
+    pub fn reset(&mut self) {
+        self.prepared = None;
+        self.engine.invalidate_placement_history();
+    }
+    pub fn frame(
+        &mut self,
+        seconds: f64,
+        width: u32,
+        height: u32,
+        scale: f32,
+        now_ms: f64,
+    ) -> Result<JsValue, JsValue> {
+        if !seconds.is_finite() || seconds < 0.0 {
+            return Err("Invalid media time".into());
+        }
+        let media_time = Duration::try_from_secs_f64(seconds)
+            .map_err(|_| JsValue::from_str("Media time exceeds supported range"))?;
+        let viewport = DanmakuViewport::with_scale(width.min(8192), height.min(8192), scale);
+        let size_due = self
+            .pending_size_at
+            .is_some_and(|deadline| now_ms >= deadline);
+        if self.prepared.is_none()
+            || self.viewport != Some(viewport)
+            || size_due
+            || seconds < self.window
+            || seconds > self.window + 5.0
+        {
+            self.engine.set_config(self.config.clone());
+            self.engine.recycle_raster_caches_if_needed();
+            let lookback = (self.config.scroll_duration_seconds as f64 * 1.3
+                / self.config.scroll_speed_factor as f64)
+                .max(4.0);
+            let start = media_time.saturating_sub(Duration::from_secs_f64(lookback));
+            let end = media_time.saturating_add(Duration::from_secs(20));
+            self.engine.sync_timeline(&self.timeline.window(start, end));
+            self.prepared = Some(self.engine.prepare(viewport, 1));
+            self.window = seconds;
+            self.viewport = Some(viewport);
+            self.pending_size_at = None;
+            self.size_deadline = None;
+        }
+        let prepared = self
+            .prepared
+            .as_ref()
+            .ok_or_else(|| JsValue::from_str("No prepared layout"))?;
+        let frame = prepared.frame_layout(media_time, 1);
+        let plan = self.engine.rasterizer_clone().render_plan_scaled(
+            &frame,
+            self.config.font_size / prepared.font_size().max(1.0),
+            prepared.atlas(),
+        );
+        let result = Object::new();
+        let mut glyphs = Vec::<f32>::with_capacity(plan.items.len() * 8);
+        let mut groups = Vec::<f32>::new();
+        let mut last = None;
+        for item in &plan.items {
+            // A group shares one paint; the border of the viewer's own
+            // comment is white beside its colored text.
+            let style = (
+                item.item_id,
+                item.color_rgba,
+                item.outline_rgba,
+                item.shadow_rgba,
+                item.shadow_offset,
+            );
+            if last != Some(style) {
+                groups.extend_from_slice(&[(glyphs.len() / 8) as f32, 0.0]);
+                groups.extend_from_slice(&item.color_rgba);
+                groups.extend_from_slice(&item.outline_rgba);
+                groups.extend_from_slice(&item.shadow_rgba);
+                groups.extend_from_slice(&item.shadow_offset);
+                last = Some(style);
+            }
+            let count = groups.len() - 15;
+            groups[count] += 1.0;
+            glyphs.extend_from_slice(&item.rect);
+            glyphs.extend_from_slice(&item.tex_rect);
+        }
+        set(
+            &result,
+            "glyphs",
+            Float32Array::from(glyphs.as_slice()).into(),
+        )?;
+        set(
+            &result,
+            "groups",
+            Float32Array::from(groups.as_slice()).into(),
+        )?;
+        if let Some(atlas) = plan.atlas {
+            if atlas.version != self.atlas_version {
+                if let Some(update) = atlas.incremental_update_from(
+                    self.atlas_version,
+                    self.atlas_size.0,
+                    self.atlas_size.1,
+                    self.atlas_size.2,
+                ) {
+                    set(&result, "x", update.x.into())?;
+                    set(&result, "y", update.y.into())?;
+                    set(&result, "width", update.width.into())?;
+                    set(&result, "height", update.height.into())?;
+                    for (name, data) in [
+                        ("fill", &atlas.fill_alpha),
+                        ("outline", &atlas.outline_alpha),
+                    ] {
+                        let mut region =
+                            Vec::with_capacity(update.width as usize * update.height as usize);
+                        for y in update.y..update.y + update.height {
+                            let start = y as usize * atlas.stride + update.x as usize;
+                            region.extend_from_slice(&data[start..start + update.width as usize]);
+                        }
+                        set(&result, name, Uint8Array::from(region.as_slice()).into())?;
+                    }
+                } else {
+                    set(&result, "width", atlas.width.into())?;
+                    set(&result, "height", atlas.height.into())?;
+                    set(
+                        &result,
+                        "fill",
+                        Uint8Array::from(atlas.fill_alpha.as_slice()).into(),
+                    )?;
+                    set(
+                        &result,
+                        "outline",
+                        Uint8Array::from(atlas.outline_alpha.as_slice()).into(),
+                    )?;
+                }
+                self.atlas_size = (atlas.width, atlas.height, atlas.stride);
+                self.atlas_version = atlas.version;
+            }
+        }
+        Ok(result.into())
+    }
+}
+impl Default for WebDanmaku {
+    fn default() -> Self {
+        Self::new()
+    }
+}
diff --git a/crates/erika/src/web/media.c b/crates/erika/src/web/media.c
new file mode 100644
index 0000000..3de6141
--- /dev/null
+++ b/crates/erika/src/web/media.c
@@ -0,0 +1,201 @@
+/* Browser demux and ASS bridge. One instance per player worker. Pixel data is
+ * never decoded here: compressed AV packets go to the browser's WebCodecs. */
+#include <emscripten.h>
+#include <libavformat/avformat.h>
+#include <libavcodec/avcodec.h>
+#include <libavutil/bprint.h>
+#include <libavutil/pixdesc.h>
+#include <ass/ass.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static AVFormatContext *format;
+static AVIOContext *io;
+static AVPacket *packet;
+static int64_t position, source_size;
+static double origin;
+static ASS_Library *library;
+static ASS_Renderer *renderer;
+static ASS_Track *subtitles;
+static int subtitle_stream = -1;
+static char error_text[256];
+static char *info;
+static int renderer_width, renderer_height, subtitle_changed;
+static size_t font_bytes;
+
+EM_ASYNC_JS(int, source_read, (double offset, int destination, int length), {
+    try { return await Module.readSource(offset, destination, length); }
+    catch (e) { Module.sourceError = String(e); return -5; }
+});
+static int read_packet(void *opaque, uint8_t *buffer, int size) {
+    if (position >= source_size) return AVERROR_EOF;
+    int remaining = (int)((source_size-position) < size ? source_size-position : size);
+    int count = source_read((double)position, (int)(uintptr_t)buffer, remaining);
+    if (count > 0) position += count;
+    return count == 0 ? AVERROR_EOF : count;
+}
+static int64_t seek_source(void *opaque, int64_t offset, int whence) {
+    if (whence == AVSEEK_SIZE) return source_size;
+    whence &= ~AVSEEK_FORCE;
+    int64_t next = whence == SEEK_SET ? offset : whence == SEEK_CUR ? position+offset : whence == SEEK_END ? source_size+offset : -1;
+    if (next < 0 || next > source_size) return AVERROR(EINVAL);
+    return position = next;
+}
+static int fail(int code) { av_strerror(code, error_text, sizeof(error_text)); return code; }
+const char *erika_error(void) { return error_text; }
+static void quote(AVBPrint *out, const char *text) {
+    av_bprint_chars(out, '"', 1);
+    for (const unsigned char *p = (const unsigned char *)(text ? text : ""); *p; ++p) {
+        if (*p == '"' || *p == '\\') av_bprintf(out, "\\%c", *p);
+        else if (*p < 32) av_bprintf(out, "\\u%04x", *p);
+        else av_bprint_chars(out, *p, 1);
+    }
+    av_bprint_chars(out, '"', 1);
+}
+static const char *metadata(AVDictionary *dict, const char *key) {
+    AVDictionaryEntry *entry = av_dict_get(dict, key, NULL, 0);
+    return entry ? entry->value : "";
+}
+void erika_close(void) {
+    if (subtitles) ass_free_track(subtitles);
+    if (renderer) ass_renderer_done(renderer);
+    if (library) ass_library_done(library);
+    subtitles = NULL; renderer = NULL; library = NULL; subtitle_stream = -1;
+    renderer_width = renderer_height = 0; font_bytes = 0;
+    av_packet_free(&packet);
+    avformat_close_input(&format);
+    if (io) { av_freep(&io->buffer); avio_context_free(&io); }
+    av_freep(&info);
+}
+int erika_open(double size, const char *name) {
+    erika_close(); position = 0; source_size = (int64_t)size;
+    uint8_t *buffer = av_malloc(65536);
+    if (!buffer) return fail(AVERROR(ENOMEM));
+    io = avio_alloc_context(buffer, 65536, 0, NULL, read_packet, NULL, seek_source);
+    if (!io) { av_free(buffer); return fail(AVERROR(ENOMEM)); }
+    format = avformat_alloc_context();
+    if (!format) return fail(AVERROR(ENOMEM));
+    format->pb = io; format->flags |= AVFMT_FLAG_CUSTOM_IO;
+    format->probesize = 2 * 1024 * 1024;
+    format->max_analyze_duration = 3 * AV_TIME_BASE;
+    int code = avformat_open_input(&format, name, NULL, NULL);
+    if (code < 0) return fail(code);
+    code = avformat_find_stream_info(format, NULL);
+    if (code < 0) return fail(code);
+    packet = av_packet_alloc();
+    if (!packet) return fail(AVERROR(ENOMEM));
+    origin = format->start_time == AV_NOPTS_VALUE ? 0 : (double)format->start_time / AV_TIME_BASE;
+    library = ass_library_init();
+    if (!library) return fail(AVERROR(ENOMEM));
+    renderer = ass_renderer_init(library);
+    if (!renderer) return fail(AVERROR(ENOMEM));
+    ass_set_cache_limits(renderer, 2048, 64);
+    ass_set_fonts(renderer, NULL, "Droid Sans Fallback", ASS_FONTPROVIDER_NONE, NULL, 1);
+    for (unsigned i = 0; i < format->nb_streams; ++i) {
+        AVStream *s = format->streams[i]; AVCodecParameters *p = s->codecpar;
+        if (p->codec_type == AVMEDIA_TYPE_ATTACHMENT && p->extradata_size > 0 && p->extradata_size <= 32*1024*1024 && font_bytes + p->extradata_size <= 128*1024*1024) {
+            ass_add_font(library, metadata(s->metadata, "filename"), (char*)p->extradata, p->extradata_size);
+            font_bytes += p->extradata_size;
+        }
+    }
+    ass_set_fonts(renderer, NULL, "Droid Sans Fallback", ASS_FONTPROVIDER_NONE, NULL, 1);
+    return 0;
+}
+const char *erika_info(void) {
+    if (!format) return "{}";
+    av_freep(&info);
+    AVBPrint out; av_bprint_init(&out, 1024, 1024*1024);
+    double duration = format->duration == AV_NOPTS_VALUE ? 0 : (double)format->duration/AV_TIME_BASE;
+    av_bprintf(&out, "{\"duration\":%.6f,\"tracks\":[", duration);
+    for (unsigned i=0; i<format->nb_streams; ++i) {
+        AVStream *s=format->streams[i]; AVCodecParameters *p=s->codecpar;
+        const AVPixFmtDescriptor *desc=av_pix_fmt_desc_get(p->format);
+        av_bprintf(&out, "%s{\"id\":%u,\"type\":", i ? ",":"", i);
+        quote(&out, av_get_media_type_string(p->codec_type));
+        av_bprintf(&out, ",\"codec\":"); quote(&out, avcodec_get_name(p->codec_id));
+        av_bprintf(&out, ",\"name\":"); quote(&out, metadata(s->metadata,"title"));
+        av_bprintf(&out, ",\"language\":"); quote(&out, metadata(s->metadata,"language"));
+        av_bprintf(&out, ",\"width\":%d,\"height\":%d,\"sampleRate\":%d,\"channels\":%d,\"profile\":%d,\"level\":%d,\"bitDepth\":%d,\"extraPtr\":%u,\"extraSize\":%d}",
+            p->width,p->height,p->sample_rate,p->ch_layout.nb_channels,p->profile,p->level,desc?desc->comp[0].depth:8,(unsigned)(uintptr_t)p->extradata,p->extradata_size);
+    }
+    av_bprintf(&out,"],\"chapters\":[");
+    for (unsigned i=0; i<format->nb_chapters; ++i) {
+        AVChapter *c = format->chapters[i];
+        double start = c->start * av_q2d(c->time_base) - origin;
+        double end = c->end * av_q2d(c->time_base) - origin;
+        av_bprintf(&out, "%s{\"title\":", i ? "," : "");
+        quote(&out, metadata(c->metadata, "title"));
+        av_bprintf(&out, ",\"start\":%.6f,\"end\":%.6f}", start, end);
+    }
+    av_bprintf(&out,"]}"); av_bprint_finalize(&out,&info); return info;
+}
+int erika_subtitle_select(int stream) {
+    if (subtitles) ass_free_track(subtitles);
+    subtitles=NULL; subtitle_stream=-1;
+    if (stream < 0) return 0;
+    if (!format || (unsigned)stream>=format->nb_streams) return fail(AVERROR(EINVAL));
+    AVCodecParameters *p=format->streams[stream]->codecpar;
+    if (p->codec_id!=AV_CODEC_ID_ASS && p->codec_id!=AV_CODEC_ID_SSA) return fail(AVERROR(ENOSYS));
+    subtitles=ass_new_track(library);
+    if (!subtitles) return fail(AVERROR(ENOMEM));
+    ass_process_codec_private(subtitles,(char*)p->extradata,p->extradata_size);
+    ass_configure_prune(subtitles, 60000);
+    subtitle_stream=stream; return 0;
+}
+int erika_subtitle_load(char *data, int length) {
+    if (subtitles) ass_free_track(subtitles);
+    subtitles=ass_read_memory(library,data,length,NULL); subtitle_stream=-1;
+    return subtitles ? 0 : fail(AVERROR_INVALIDDATA);
+}
+int erika_add_font(char *name, char *data, int length) {
+    if (!library || length<1 || length>32*1024*1024 || font_bytes + length > 128*1024*1024) return fail(AVERROR(EINVAL));
+    ass_add_font(library,name,data,length); font_bytes += length;
+    ass_set_fonts(renderer,NULL,"Droid Sans Fallback",ASS_FONTPROVIDER_NONE,NULL,1); return 0;
+}
+int erika_read(void) {
+    av_packet_unref(packet);
+    int result=av_read_frame(format,packet);
+    if (result==AVERROR_EOF) return 0;
+    if (result<0) return fail(result);
+    if (packet->stream_index==subtitle_stream && subtitles) {
+        AVStream *s=format->streams[subtitle_stream];
+        double pts=(packet->pts==AV_NOPTS_VALUE?0:packet->pts*av_q2d(s->time_base))-origin;
+        ass_process_chunk(subtitles,(char*)packet->data,packet->size,(long long)(pts*1000),(long long)(packet->duration*av_q2d(s->time_base)*1000));
+    }
+    return 1;
+}
+uint8_t *erika_packet_data(void) { return packet->data; }
+int erika_packet_size(void) { return packet->size; }
+int erika_packet_stream(void) { return packet->stream_index; }
+double erika_packet_time(void) { return ((packet->pts==AV_NOPTS_VALUE ? (packet->dts==AV_NOPTS_VALUE?0:packet->dts) : packet->pts)*av_q2d(format->streams[packet->stream_index]->time_base)-origin)*1000000; }
+double erika_packet_duration(void) { return packet->duration*av_q2d(format->streams[packet->stream_index]->time_base)*1000000; }
+int erika_packet_key(void) { return !!(packet->flags & AV_PKT_FLAG_KEY); }
+int erika_seek(double seconds) {
+    int result=avformat_seek_file(format,-1,INT64_MIN,(int64_t)((seconds+origin)*AV_TIME_BASE),INT64_MAX,0);
+    if (result<0) return fail(result);
+    av_packet_unref(packet);
+    // ASS events are on an absolute timeline. Keep already observed long events
+    // across seeks; libass read-order checking suppresses replayed duplicates.
+    return 0;
+}
+ASS_Image *erika_subtitle_render(double seconds, int width, int height, double scale) {
+    if (!subtitles || !renderer) return NULL;
+    if (renderer_width != width || renderer_height != height) {
+        ass_set_frame_size(renderer,width,height); ass_set_storage_size(renderer,width,height);
+        renderer_width=width; renderer_height=height;
+    }
+    ass_set_font_scale(renderer,scale);
