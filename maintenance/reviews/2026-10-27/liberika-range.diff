diff --git a/crates/erika/testdata/subtitle-seek/generate.sh b/crates/erika/testdata/subtitle-seek/generate.sh
new file mode 100755
index 0000000..29eecd6
--- /dev/null
+++ b/crates/erika/testdata/subtitle-seek/generate.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")"
+# Original synthetic material, under the repository's MPL-2.0 license.
+# One video frame per second for 60 s; the SubRip files become ASS tracks.
+video='color=c=0x304866:size=64x64:rate=1:duration=60'
+common=(-c:v mpeg4 -q:v 5 -c:s ass -threads 1 -fflags +bitexact -flags:v +bitexact)
+ffmpeg -hide_banner -loglevel error -nostdin \
+  -f lavfi -i "$video" -i long.srt \
+  -map 0:v -map 1:0 "${common[@]}" -y long.mkv
+ffmpeg -hide_banner -loglevel error -nostdin \
+  -f lavfi -i "$video" -i track-a.srt -i track-b.srt \
+  -map 0:v -map 1:0 -map 2:0 "${common[@]}" -y two-tracks.mkv
+ffmpeg -hide_banner -loglevel error -nostdin \
+  -f lavfi -i "$video" -i switch-a.srt -i switch-b.srt \
+  -map 0:v -map 1:0 -map 2:0 "${common[@]}" -y switch-track.mkv
+shasum -a 256 long.mkv two-tracks.mkv switch-track.mkv long.srt track-a.srt track-b.srt \
+  switch-a.srt switch-b.srt > SHA256SUMS
