+                border(Border(1f, BorderStyle.SOLID, Color(0xFF007AFF)))
+            }
+            allCenter()
+        }
+        Text {
+            attr {
+                text(label)
+                fontSize(14f)
+                color(if (selected) Color(0xFF007AFF) else Color(0xFF3C3C43))
