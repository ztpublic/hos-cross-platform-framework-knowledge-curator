+- (CGFloat)p_titleHostWidth:(UINavigationBar *)bar {
+    if (bar.bounds.size.width > 1) {
+        return bar.bounds.size.width;
+    }
+    UIView *root = self.hr_rootView;
+    if (root.bounds.size.width > 1) {
+        return root.bounds.size.width;
