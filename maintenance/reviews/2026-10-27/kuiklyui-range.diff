+    spacer.accessibilityIdentifier = identifier;
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 260000
+    if (@available(iOS 26.0, *)) {
+        spacer.hidesSharedBackground = YES;
+        spacer.sharesBackground = NO;
+    }
