+        layout = FoldSplitStackLayout(
+            masterWidth = MASTER_WIDTH,
+            masterMinWidth = MASTER_MIN_WIDTH,
+            masterMaxWidth = MASTER_MAX_WIDTH,
+            masterInset = MASTER_INSET,
