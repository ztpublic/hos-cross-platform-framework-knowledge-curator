+private fun foldSettingsMasterListBottomSpacer(
+    controller: FoldSplitStackController,
+    page: FoldAdaptiveSettingsDemo,
+): Float {
+    val chromePad = controller.systemToolbarContentInsetBottom()
+    if (chromePad > 0f) {
+        return chromePad
+    }
+    return if (controller.isCompact()) {
+        foldSettingsBottomPad(page, controller)
+    } else {
+        18f
+    }
+}
+
+/** 列表滚到底时停在系统 toolbar / Home 条上方。 */
+private fun foldSettingsBottomPad(
+    page: FoldAdaptiveSettingsDemo,
+    controller: FoldSplitStackController,
+): Float {
+    val chromePad = controller.systemToolbarContentInsetBottom()
+    if (chromePad > 0f) {
+        return chromePad
+    }
+    return max(page.pageData.safeAreaInsets.bottom + 8f, 48f)
+}
+
+/** 侧栏内容到浮窗左右边缘的留白。小屏单独铺满时还要让开竖栏。 */
+private fun foldSettingsMasterInset(controller: FoldSplitStackController): Float =
+    if (controller.isCompact()) {
+        FoldAdaptiveSettingsDemo.COMPACT_PAD
+    } else {
+        FoldAdaptiveSettingsDemo.MASTER_PAD
+    }
+
+private fun foldSettingsMasterPadLeft(controller: FoldSplitStackController): Float {
+    val pad = foldSettingsMasterInset(controller)
+    if (!controller.isCompact()) {
+        return pad
+    }
+    return max(pad, controller.leadingSafeInset())
+}
+
+private fun foldSettingsMasterPadRight(controller: FoldSplitStackController): Float {
+    val pad = foldSettingsMasterInset(controller)
+    if (!controller.isCompact()) {
+        return pad
+    }
+    return max(pad, controller.trailingSafeInset())
+}
