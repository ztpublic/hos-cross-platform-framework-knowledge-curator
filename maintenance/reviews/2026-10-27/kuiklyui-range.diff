+    val imageHeight: Float,
+    val swatch: Color,
+)
+
+private fun composeFeedSwatch(index: Int): Color =
+    when (index % 4) {
+        0 -> Color(0xFF64D2FF)
+        1 -> Color(0xFF30D158)
+        2 -> Color(0xFFFF9F0A)
+        else -> Color(0xFFBF5AF2)
