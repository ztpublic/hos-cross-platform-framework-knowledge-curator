+
+        /** 侧栏行左右内边距。 */
+        const val MASTER_ROW_PAD = 12f
+
+        /** 分组行的图标尺寸与右边距，侧栏和详情共用一套，行文字才能对齐。 */
+        const val ROW_ICON = 29f
+        const val ROW_ICON_GAP = 12f
